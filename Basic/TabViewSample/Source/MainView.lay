<div class="AView-Style" data-base="AView" data-class="MainView" style="left: 0px; top: 0px; width: 100%; height: 100%; background-color: transparent;" data-class-map="{&quot;afc&quot;:[&quot;AView&quot;,&quot;AVertical&quot;,&quot;ALabel&quot;,&quot;ATabView&quot;,&quot;AButton&quot;]}">
    <div data-base="AVertical" data-class="AVertical" class="AFlexLayout-Style AVertical-Style" style="width: 100%; height: 100%; flex-direction: column; align-items: stretch; justify-content: center; left: 0px; top: 0px; position: absolute;">
        <div style="position: relative; box-sizing: border-box; display: inline-block;">
            <div class="AView-Style" data-base="AView" data-class="AView" style="width: 100%; height: 50px; left: 0px; top: 0px; position: relative;">
                <label class="ALabel-Style" data-base="ALabel" data-class="ALabel" id="MainView--titleLabel" style="width: auto; height: auto; top: 0px; left: calc(50% - 84px); padding-left: 10px; background-color: rgba(0, 0, 0, 0); font-size: 20px; font-weight: bold; color: rgb(0, 0, 0); line-height: 50px;" data-center-x="true">TabView Sample</label>
            </div>
        </div>
        <div style="position: relative; box-sizing: border-box; display: inline-block; flex-grow: 1;">
            <div data-base="ATabView" data-class="ATabView" class="ATabView-Style" data-state="0" style="width: 100%; height: 100%; left: 0px; top: 0px; position: relative;" id="MainView--tabView" data-tab-history="true" data-style-select="select_style">
                <div class="tab_area" style="height: 40px;">
                    <span class="ATabView-select" style="line-height: 40px;">tab1</span>
                    <span class="ATabView-deselect" style="line-height: 40px;">tab2</span>
                    <span class="ATabView-deselect" style="line-height: 40px;">tab3</span>
                </div>
                <div class="tab_contents" style="height: calc(100% - 40px);"></div>
            </div>
        </div>
        <div style="position: relative; box-sizing: border-box; display: inline-block;">
            <div class="AView-Style" data-base="AView" data-class="AView" style="width: 100%; height: 60px; left: 0px; position: relative; top: 0px;">
                <button class="AButton-Style" data-base="AButton" data-class="AButton" data-flag="0001" data-listener-click="MainView:onButtonTabShowClick" id="MainView--ButtonTabShow" style="width: 120px; height: 40px; left: 10px; top: 10px;" data-style-over=" select_style" data-style-down=" select_style">Show Tab</button>
                <button class="AButton-Style" data-base="AButton" data-class="AButton" data-flag="0001" data-listener-click="MainView:onButtonTabHideClick" id="MainView--ButtonTabHide" style="width: 120px; height: 40px; left: 150px; top: 10px;" data-style-over=" select_style" data-style-down=" select_style">Hide Tab</button>
            </div>
        </div>
    </div>
</div>