<div class="AView-Style" data-base="AView" data-class="SubView3" id="SubView3--SubView3" style="width: 100%; height: 100%; background-color: rgb(255, 255, 0); left: 0px; top: 0px;" data-class-map="{&quot;afc&quot;:[&quot;AView&quot;,&quot;ALabel&quot;,&quot;AButton&quot;]}">
    <label class="ALabel-Style" data-base="ALabel" data-class="ALabel" id="SubView3--TitleLabel" style="width: auto; height: auto; left: 20px; top: 20px; font-weight: bold; color: rgb(0, 0, 0); font-size: 18px;">Sub View 3</label>
    <button class="AButton-Style" data-base="AButton" data-class="AButton" data-flag="0001" id="SubView3--prevBtn" style="width: 120px; height: 40px; left: calc(50% - 60px); top: calc(50% - 20px); position: absolute; background-color: rgb(255, 255, 255);" data-style=" " data-listener-click="SubView3:onPrevBtnClick" data-style-over=" select_style" data-style-down=" select_style" data-center-x="true" data-center-y="true">prev tab</button>
</div>