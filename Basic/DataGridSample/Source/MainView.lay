<div data-base="AView" data-class="MainView" class="AView-Style" style="left: 0px; top: 0px; width: 100%; height: 100%; background-color: rgb(239, 239, 239); position: absolute;" data-class-map="{&quot;afc&quot;:[&quot;AView&quot;,&quot;AFlexLayout&quot;,&quot;ALabel&quot;,&quot;ATabView&quot;]}" data-browser-width="660" data-browser-height="810">
    <div data-base="AFlexLayout" data-class="AFlexLayout" class="AFlexLayout-Style" style="width: 100%; height: 100%; align-items: stretch; left: 0px; top: 0px; position: absolute; flex-direction: column;">
        <div style="position: relative; box-sizing: border-box; display: inline-block;">
            <label data-base="ALabel" data-class="ALabel" class="ALabel-Style" style="width: 320px; height: 39px; left: 0px; top: 0px; font-size: 24px; font-weight: bold; text-align: left; vertical-align: baseline; position: relative;">Data Grid Sample</label>
        </div>
        <div style="position: relative; box-sizing: border-box; display: inline-block; flex-grow: 1;">
            <div data-base="ATabView" data-class="ATabView" class="ATabView-Style" data-state="0" style="width: 100%; height: 100%; left: 0px; top: 0px; position: relative;" data-stretch-height="true" data-tab-select="sample3" data-tabinfo-sample1="sample1,pivot,Source/TestView.lay,1" data-tabinfo-sample3="sample3,normal,Source/TestView3.lay,0" data-tabinfo-sample2="sample2,merge,Source/TestView2.lay,2">
                <div class="tab_area" style="height: 40px;">
                    <span class="ATabView-select" style="line-height: 40px;">tab1</span>
                    <span class="ATabView-deselect" style="line-height: 40px;">tab2</span>
                    <span class="ATabView-deselect" style="line-height: 40px;">tab3</span>
                </div>
                <div class="tab_contents"></div>
            </div>
        </div>
    </div>
</div>